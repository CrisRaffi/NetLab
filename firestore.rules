rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Dados pessoais do usuário (progresso, quadros, quizzes)
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Chat geral da comunidade — leitura pública, escrita só logado
    match /community-chat/{docId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.authorUid;
    }

    // Dúvidas da comunidade — leitura pública, escrita só logado.
    // update liberado para qualquer logado porque respostas usam arrayUnion.
    match /community-doubts/{docId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == resource.data.authorUid;
    }
  }
}