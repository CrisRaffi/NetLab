# Credenciais do Firebase (Autenticação + Firestore)
# Copie este arquivo para .env, preencha com os valores do console do Firebase
# (Project settings -> General -> Your apps -> Web app -> Config) e NUNCA
# commite o .env no repositório.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=